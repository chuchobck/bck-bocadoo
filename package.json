{
  "name": "bck-bocadoo",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/db.mjs up",
    "db:status": "node scripts/db.mjs status",
    "db:rollback": "node scripts/db.mjs rollback",
    "db:new": "node scripts/db.mjs new",
    "db:baseline": "node scripts/db.mjs baseline"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^10.1.10",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-fastify": "^12.4.2",
    "@nestjs/swagger": "^12.1.1",
    "@node-rs/argon2": "^2.2.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "jose": "^5.10.0",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@swc/core": "^1.16.22",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "dbmate": "^2.38.1",
    "pino-pretty": "^13.2.0",
    "typescript": "^5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
