# Copia a .env y rellena. NUNCA subas .env.
NODE_ENV=development
PORT=3000
# Conexión por el pooler de Neon, con el rol bck_api (la que usa la API)
DATABASE_URL=postgresql://bck_api:CLAVE@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Conexión directa con bck_servicio (auth y cron)
DATABASE_SERVICE_URL=postgresql://bck_servicio:CLAVE@HOST.REGION.aws.neon.tech/neondb?sslmode=require
# Conexión directa del dueño, solo para migraciones
DATABASE_MIGRATE_URL=postgresql://neondb_owner:CLAVE@HOST.REGION.aws.neon.tech/neondb?sslmode=require
# Conexiones máximas por pool (el pooler de Neon multiplexa; 10 es suficiente)
DB_POOL_MAX=10
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3001
# --- Autenticación (genera la llave con: pnpm keys:generate). Obligatoria en producción.
JWT_KEY_ID=k1
JWT_PRIVATE_KEY=
# Al rotar: JSON {"kid-anterior":"PEM público"} hasta que venzan los tokens viejos (15 min)
JWT_PREVIOUS_PUBLIC_KEYS=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# --- Abuso
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
SIGNUP_RATE_LIMIT_MAX=10
BODY_LIMIT_BYTES=102400
# Swagger: encendido salvo en producción; fuerza con true/false
SWAGGER_ENABLED=
